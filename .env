# ----------------------------------------------------------
# Variables de entorno del proyecto.
# docker-compose.yml lee estos valores automáticamente.
# NO subir este archivo con contraseñas reales a un repositorio público.
# ----------------------------------------------------------

# Base de datos MySQL
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=crud_usuarios
MYSQL_USER=crud_user
MYSQL_PASSWORD=crud_pass123

# Backend (Spring Boot)
DB_HOST=db
DB_PORT=3306
DB_NAME=crud_usuarios
DB_USER=crud_user
DB_PASSWORD=crud_pass123
SERVER_PORT=8080

# Origen exacto del frontend permitido para CORS con cookies de sesión.
# Debe coincidir con la URL desde donde se abre la página en el navegador.
# Si despliegas en la intranet, cámbialo por "http://IP_DE_LA_VM:8081"
FRONTEND_ORIGIN=http://localhost:8081

# Puertos expuestos hacia el equipo anfitrión
FRONTEND_PORT=8081
BACKEND_PORT=8080
MYSQL_PORT=3306
